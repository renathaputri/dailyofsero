# GrowthWithSero MVP Environment Configuration

# Database: PostgreSQL
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/growthwithsero?schema=public"

# Auth Session Secret (min 32 chars)
JWT_SECRET="growthwithsero-super-secure-jwt-session-secret-key-2026"

# AES-256 Journal Encryption Key (32 bytes = 64 hex chars or 32 string chars)
JOURNAL_ENCRYPTION_KEY="sero_growth_journal_aes256_key_32bytes!!"

# App URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# AwareMind Official Links
NEXT_PUBLIC_AWAREMIND_URL="https://awaremind.id"
NEXT_PUBLIC_AWAREMIND_EMERGENCY_URL="https://awaremind.id/darurat"

# Optional Email Provider (Resend / console fallback)
# RESEND_API_KEY="re_..."
EMAIL_FROM="GrowthWithSero <noreply@growthwithsero.com>"

# Optional Vercel Blob Token
# BLOB_READ_WRITE_TOKEN="..."
